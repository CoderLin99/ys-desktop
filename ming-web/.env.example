# ============================================
# Database / 数据库
# ============================================

# Postgres 连接串（Neon / Supabase / 本地 Docker）
# 本地示例：postgresql://postgres:postgres@localhost:5432/ming_web?sslmode=disable
DATABASE_URL=

# ============================================
# Auth / 鉴权（Better Auth）
# ============================================

# 至少 32 位随机串：openssl rand -hex 32
BETTER_AUTH_SECRET=

# 应用对外 URL
BETTER_AUTH_URL=http://localhost:5555

# 浏览器端可选（不设则用 window.location.origin）
NEXT_PUBLIC_APP_URL=http://localhost:5555

# ============================================
# AI / 大模型（仅服务端，勿暴露到 NEXT_PUBLIC）
# ============================================

AI_PROVIDER=openai-compatible
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
